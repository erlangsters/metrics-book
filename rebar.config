{erl_opts, [debug_info]}.
{deps, [
  {book_storage, {git, "https://github.com/erlangsters/book-storage.git", {tag, "0.0.1"}}}
]}.

{eunit_opts, [verbose]}.

{profiles, [
  {docs, [
    {plugins, [rebar3_ex_doc]},
    {ex_doc, [
      {main, "README.md"},
      {extras, [
        "README.md"
      ]},
      {output, "_build/docs/site"},
      {source_url, "https://github.com/erlangsters/metrics-book"}
    ]}
  ]}
]}.
